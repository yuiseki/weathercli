{
  "name": "@yuiseki/weathercli",
  "version": "0.1.0",
  "description": "Weather CLI with Open-Meteo and local cache",
  "main": "dist/index.js",
  "bin": {
    "weather": "dist/index.js",
    "weathercli": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js",
    "sync": "node dist/index.js sync"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "weather",
    "cli",
    "open-meteo"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.15.0",
    "commander": "^14.0.3",
    "dotenv": "^17.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
